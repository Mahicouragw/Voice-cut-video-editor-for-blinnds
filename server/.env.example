# Private server file only. Copy to server/.env for local development.
# Generate a separate random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_ACCESS_KEY=
ALLOWED_ORIGIN=https://mahicouragw.github.io
# Allows only the packaged Android app's localhost origin, still requiring SERVER_ACCESS_KEY.
ALLOW_ANDROID_APP=true
# Provider secrets: never paste into the website, source code, or Android assets.
OPENAI_API_KEY=
# Free caption options: configure any of these instead of, or alongside, OpenAI.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional: absolute path to the deep_filter binary. Defaults to deep_filter on PATH.
# DEEPFILTER_PATH=/usr/local/bin/deep_filter
# A conservative per-process request-attempt cap; resets on restart, not a billing guarantee.
MAX_AI_REQUESTS_PER_HOUR=20
PORT=3001
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
