# Private server file only. Copy to server/.env for local development.
# Generate a separate random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_ACCESS_KEY=
ALLOWED_ORIGIN=https://mahicouragw.github.io
# Legacy flag for the old packaged app's localhost origin. The current app loads
# the website directly, so it uses the website origin above and needs no flag.
# ALLOW_ANDROID_APP=true
# Provider secrets: never paste into the website, source code, or Android assets.
OPENAI_API_KEY=
# Free caption options: configure any of these instead of, or alongside, OpenAI.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
# Free AI Image Generation (~170 FLUX.1-schnell images/day on Cloudflare Workers AI free plan):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Free Hugging Face ZeroGPU token (free account at https://huggingface.co/settings/tokens — unlocks daily ZeroGPU quota for Wan 2.1, LTX-Video & FLUX.1-schnell):
HF_TOKEN=
# Optional unified Image + Video (Wan / Seedance / Veo / FLUX) key from https://enter.pollinations.ai:
POLLINATIONS_API_KEY=
# Optional AI Video (Wan 2.1 / Kling / LTX-Video) keys:
FAL_KEY=
REPLICATE_API_TOKEN=
# Optional: absolute path to the deep_filter binary. Defaults to deep_filter on PATH.
# DEEPFILTER_PATH=/usr/local/bin/deep_filter
# A conservative per-process request-attempt cap; resets on restart, not a billing guarantee.
MAX_AI_REQUESTS_PER_HOUR=20
PORT=3001
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
